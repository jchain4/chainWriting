{
  "name": "chain-writing",
  "version": "0.1.0",
  "type": "module",
  "description": "Embeddable rich-text editor component built on Tiptap",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "build:lib": "tsc -b && vite build --config vite.lib.config.ts",
    "lint": "oxlint",
    "preview": "vite preview"
  },
  "exports": {
    ".": {
      "import": "./dist/index.mjs",
      "require": "./dist/index.cjs",
      "types": "./dist/index.d.ts"
    },
    "./style.css": "./dist/chain-writing.css"
  },
  "types": "./dist/index.d.ts",
  "files": ["dist"],
  "peerDependencies": {
    "react": ">=18",
    "react-dom": ">=18",
    "@tiptap/react": ">=3",
    "@tiptap/starter-kit": ">=3",
    "@tiptap/extension-placeholder": ">=3",
    "@tiptap/extension-typography": ">=3",
    "@tiptap/pm": ">=3"
  },
  "devDependencies": {
    "@tiptap/extension-placeholder": "^3.30.1",
    "@tiptap/extension-typography": "^3.30.1",
    "@tiptap/pm": "^3.30.1",
    "@tiptap/react": "^3.30.1",
    "@tiptap/starter-kit": "^3.30.1",
    "@types/node": "^24.13.3",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.4",
    "idb-keyval": "^6.3.0",
    "oxlint": "^1.75.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "typescript": "~6.0.2",
    "vite": "^8.2.0",
    "vite-plugin-dts": "^5.0.3"
  }
}
